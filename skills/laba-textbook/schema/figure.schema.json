{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "figure.schema.json",
 "title": "図の記述（型＋要素）。座標・色・線の太さは書かない（GNOTO が型の規則から決める）。キー名 style・src・href・html は GNOTO の読み込みで落ちるので使わない",
 "type": "object",
 "required": [
  "kind"
 ],
 "additionalProperties": false,
 "properties": {
  "kind": {
   "enum": [
    "flow",
    "tree",
    "table",
    "matrix",
    "timeline",
    "concept",
    "relation",
    "compare",
    "chart",
    "scale"
   ]
  },
  "caption": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "no": {
     "type": "string",
     "maxLength": 12
    },
    "title": {
     "type": "string",
     "maxLength": 40
    }
   }
  },
  "width": {
   "enum": [
    "text",
    "wide",
    "page"
   ]
  },
  "direction": {
   "enum": [
    "down",
    "right"
   ]
  },
  "nodes": {
   "type": "array",
   "maxItems": 24,
   "items": {
    "type": "object",
    "required": [
     "id",
     "label"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,16}$"
     },
     "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
     },
     "shape": {
      "enum": [
       "box",
       "round",
       "ellipse"
      ]
     },
     "tone": {
      "enum": [
       "base",
       "key",
       "mute"
      ]
     },
     "group": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,16}$"
     },
     "pict": {
      "enum": [
       "person",
       "building",
       "land",
       "none"
      ]
     },
     "parent": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,16}$"
     }
    }
   }
  },
  "edges": {
   "type": "array",
   "maxItems": 24,
   "items": {
    "type": "object",
    "required": [
     "from",
     "to"
    ],
    "additionalProperties": false,
    "properties": {
     "from": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,16}$"
     },
     "to": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,16}$"
     },
     "label": {
      "type": "string",
      "maxLength": 12
     },
     "head": {
      "enum": [
       "arrow",
       "none",
       "both"
      ]
     },
     "line": {
      "enum": [
       "solid",
       "dashed",
       "thick",
       "wedge",
       "cancel"
      ]
     }
    }
   }
  },
  "groups": {
   "type": "array",
   "maxItems": 6,
   "items": {
    "type": "object",
    "required": [
     "id"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,16}$"
     },
     "label": {
      "type": "string",
      "maxLength": 16
     }
    }
   }
  },
  "treeStyle": {
   "enum": [
    "bracket",
    "nested",
    "region",
    "brace"
   ]
  },
  "head": {
   "type": "array",
   "minItems": 2,
   "maxItems": 6,
   "items": {
    "type": "string",
    "maxLength": 16
   }
  },
  "rows": {
   "type": "array",
   "maxItems": 12,
   "items": {
    "type": "array",
    "maxItems": 6,
    "items": {
     "type": "string",
     "maxLength": 40
    }
   }
  },
  "rowHead": {
   "type": "boolean"
  },
  "corner": {
   "enum": [
    "none",
    "diag"
   ]
  },
  "rowAxis": {
   "type": "string",
   "maxLength": 12
  },
  "colAxis": {
   "type": "string",
   "maxLength": 12
  },
  "events": {
   "type": "array",
   "maxItems": 8,
   "items": {
    "type": "object",
    "required": [
     "when",
     "what"
    ],
    "additionalProperties": false,
    "properties": {
     "when": {
      "type": "string",
      "maxLength": 16
     },
     "what": {
      "type": "string",
      "maxLength": 30
     },
     "to": {
      "type": "string",
      "maxLength": 16
     }
    }
   }
  },
  "note": {
   "type": "string",
   "maxLength": 80
  },
  "panelKind": {
   "enum": [
    "relation"
   ]
  },
  "slots": {
   "type": "object",
   "maxProperties": 8,
   "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]{0,15}$"
   },
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "integer",
     "minimum": 0,
     "maximum": 3
    },
    "minItems": 2,
    "maxItems": 2
   }
  },
  "panels": {
   "type": "array",
   "minItems": 2,
   "maxItems": 3,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "title",
     "nodes"
    ],
    "properties": {
     "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8
     },
     "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
       "$ref": "#/$defs/panelNode"
      }
     },
     "edges": {
      "type": "array",
      "maxItems": 12,
      "items": {
       "$ref": "#/$defs/relEdge"
      }
     },
     "note": {
      "type": "string",
      "maxLength": 30
     }
    }
   }
  },
  "x": {
   "type": "object",
   "required": [
    "cats"
   ],
   "additionalProperties": false,
   "properties": {
    "cats": {
     "type": "array",
     "minItems": 3,
     "maxItems": 12,
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8
     }
    },
    "label": {
     "type": "string",
     "maxLength": 10
    }
   }
  },
  "y": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "unit": {
     "type": "string",
     "maxLength": 6
    },
    "label": {
     "type": "string",
     "maxLength": 10
    }
   }
  },
  "y2": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "unit": {
     "type": "string",
     "maxLength": 6
    },
    "label": {
     "type": "string",
     "maxLength": 10
    }
   }
  },
  "series": {
   "type": "array",
   "minItems": 1,
   "maxItems": 3,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "label",
     "type",
     "values"
    ],
    "properties": {
     "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8
     },
     "type": {
      "enum": [
       "line",
       "bar"
      ]
     },
     "axis": {
      "enum": [
       "left",
       "right"
      ]
     },
     "values": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "tone": {
      "enum": [
       "base",
       "key"
      ]
     }
    }
   }
  },
  "marks": {
   "type": "array",
   "maxItems": 3,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "at"
    ],
    "properties": {
     "at": {
      "type": "string",
      "maxLength": 8
     },
     "label": {
      "type": "string",
      "maxLength": 8
     }
    }
   }
  },
  "ends": {
   "type": "array",
   "minItems": 2,
   "maxItems": 2,
   "items": {
    "type": "string",
    "minLength": 1,
    "maxLength": 4
   }
  },
  "bar": {
   "enum": [
    "wedge",
    "band"
   ]
  },
  "axisLabel": {
   "type": "string",
   "maxLength": 20
  },
  "items": {
   "type": "array",
   "minItems": 2,
   "maxItems": 5,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "at",
     "label"
    ],
    "properties": {
     "at": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8,
      "pattern": "^[^\\u0000-\\u001f]*$"
     },
     "sub": {
      "type": "string",
      "maxLength": 8,
      "pattern": "^[^\\u0000-\\u001f]*$"
     },
     "tone": {
      "enum": [
       "base",
       "key"
      ]
     }
    }
   }
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "kind": {
      "const": "flow"
     }
    }
   },
   "then": {
    "required": [
     "nodes",
     "edges"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "relation"
     }
    }
   },
   "then": {
    "required": [
     "nodes",
     "edges"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "concept"
     }
    }
   },
   "then": {
    "required": [
     "nodes"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "tree"
     }
    }
   },
   "then": {
    "required": [
     "nodes"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "table"
     }
    }
   },
   "then": {
    "required": [
     "head",
     "rows"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "matrix"
     }
    }
   },
   "then": {
    "required": [
     "head",
     "rows",
     "rowAxis",
     "colAxis"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "timeline"
     }
    }
   },
   "then": {
    "required": [
     "events"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "compare"
     }
    }
   },
   "then": {
    "required": [
     "panels",
     "slots"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "chart"
     }
    }
   },
   "then": {
    "required": [
     "x",
     "series"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "scale"
     }
    }
   },
   "then": {
    "required": [
     "ends",
     "items"
    ]
   }
  }
 ],
 "$defs": {
  "slotId": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]{0,15}$"
  },
  "relEdge": {
   "type": "object",
   "required": [
    "from",
    "to"
   ],
   "additionalProperties": false,
   "properties": {
    "from": {
     "$ref": "#/$defs/slotId"
    },
    "to": {
     "$ref": "#/$defs/slotId"
    },
    "label": {
     "type": "string",
     "maxLength": 12
    },
    "head": {
     "enum": [
      "arrow",
      "none",
      "both"
     ]
    },
    "line": {
     "enum": [
      "solid",
      "dashed",
      "thick",
      "wedge",
      "cancel"
     ]
    }
   }
  },
  "panelNode": {
   "type": "object",
   "required": [
    "id",
    "label"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "$ref": "#/$defs/slotId"
    },
    "label": {
     "type": "string",
     "minLength": 1,
     "maxLength": 12
    },
    "pict": {
     "enum": [
      "person",
      "building",
      "land",
      "none"
     ]
    },
    "gone": {
     "type": "boolean"
    },
    "tone": {
     "enum": [
      "base",
      "key",
      "mute"
     ]
    }
   }
  }
 }
}